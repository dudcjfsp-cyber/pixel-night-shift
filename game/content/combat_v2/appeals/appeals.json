{
  "schema_version": 1,
  "rules": [
    {
      "id": "debugger_incoming_damage",
      "operator_id": "debugger",
      "trigger": "diagnosis_changed",
      "conditions": [{"key": "diagnosis_kind", "op": "eq", "value": "incoming_damage"}],
      "observation_template": "피해 과다 진단이 표시됐습니다.",
      "request_template": "유입 오류를 버티도록 제 안정성 강화를 검토해 주세요.",
      "priority": 82,
      "operator_cooldown_seconds": 12,
      "global_cooldown_seconds": 4,
      "dedupe_key": "debugger_incoming_damage"
    },
    {
      "id": "debugger_patch_tradeoff",
      "operator_id": "debugger",
      "trigger": "diagnosis_changed",
      "conditions": [{"key": "diagnosis_kind", "op": "eq", "value": "patch_tradeoff"}],
      "observation_template": "패치 부작용 진단이 표시됐습니다.",
      "request_template": "부작용을 흡수할 제 방어 역할도 함께 검토해 주세요.",
