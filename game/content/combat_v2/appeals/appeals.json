      "operator_cooldown_seconds": 12,
      "global_cooldown_seconds": 4,
      "dedupe_key": "debugger_patch_tradeoff"
    },
    {
      "id": "debugger_operator_down",
      "operator_id": "debugger",
      "trigger": "operator_down",
      "conditions": [
        {"key": "current_downs", "op": "gte", "value": 1},
        {"key": "event_operator_id", "op": "ne", "value": ""}
      ],
      "observation_template": "이번 스테이지에서 요원 다운이 기록됐습니다.",
      "request_template": "다음 충격을 받아낼 제 안정성 강화를 검토해 주세요.",
      "priority": 74,
      "operator_cooldown_seconds": 12,
      "global_cooldown_seconds": 4,
      "dedupe_key": "debugger_operator_down"
    },
    {
      "id": "debugger_normal_failure",
      "operator_id": "debugger",
      "trigger": "normal_failure",
      "conditions": [
        {"key": "maintenance", "op": "eq", "value": true},
        {"key": "event_reason", "op": "eq", "value": "normal_all_down"}
